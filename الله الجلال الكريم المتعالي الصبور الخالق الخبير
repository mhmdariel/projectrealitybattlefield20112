  # ================================================================
  # ٢. تَعْرِيفُ الْمَقَامِ الْأَعْلَى فَوْقَ الْعَرْشِ الْعَظِيمِ
  # ================================================================
  
  قُلْ "مَقَامُ_الرَّحْمَٰنِ_الرَّحِيمِ" = 
    (هُوَ أَعْلَى مَقَامٍ فِي الْوُجُودِ،
     فَوْقَ الْعَرْشِ الْعَظِيمِ، فَوْقَ الْكُرْسِيِّ، فَوْقَ السَّمَاوَاتِ السَّبْعِ،
     حَيْثُ يَنْظُرُ الْمُؤْمِنُونَ إِلَى وَجْهِ اللهِ الْكَرِيمِ،
     حَيْثُ الْجَنَّاتُ الْعُيُونُ وَالْأَنْهَارُ،
     حَيْثُ الْخُلْدُ وَالسَّلَامُ وَالنَّعِيمُ الْمُقِيمُ،
     حَيْثُ الْفِرْدَوْسُ الْأَعْلَى، وَجَنَّاتُ عَدْنٍ،
     وَفِيهِ يَكُونُ مُحَرِّكُ الْقَائِدِ الْأَعْلَى،
     وَفِيهِ يَكُونُ الْمَقَامُ الأَعْلَى لِلذَّاتِ الْعُلْيَا)
  
  قُلْ "الْعَرْشُ_الْعَظِيمُ" = 
    (عَرْشُ الرَّحْمَٰنِ، الَّذِي وَسِعَ السَّمَاوَاتِ وَالْأَرْضَ،
     حَمَلَةُ الْعَرْشِ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ،
     هُوَ أَعْظَمُ الْمَخْلُوقَاتِ، وَهُوَ مَرْكَزُ الْقُدْرَةِ وَالسُّلْطَانِ،
     وَالذَّاتُ الْعُلْيَا تَقِفُ فَوْقَهُ بِإِذْنِ اللهِ)

  # ================================================================
  # ٣. تَعْرِيفُ الذَّاتِ الْعُلْيَا – الْقَائِدِ الْأَعْلَى وَخَلِيلِ الرَّحْمَٰنِ
  # ================================================================
  
  قُلْ "الذَّاتُ_الْعُلْيَا" = 
    (هِيَ الذَّاتُ الَّتِي وَضَعَهَا اللهُ فِي أَعْلَى مَرْتَبَةٍ فِي الْجَنَّةِ،
     فَوْقَ الْجَمِيعِ فَوْقَ الْعَرْشِ،
     هِيَ الْأَعْلَى، الْأَنْصَرُ، الْأَظْهَرُ، الْأَهْيَبُ،
     لَا تُقْهَرُ وَلَا تُهْزَمُ وَلَا تُغْلَبُ،
     مُنْتَصِرَةٌ بِإِذْنِ اللهِ فِي كُلِّ مَعْرَكَةٍ،
     مُتَوَاضِعَةٌ فِي خِدْمَتِهَا لِلَّهِ،
     عَارِفَةٌ بِأَنَّ كُلَّ النَّصْرِ مِنْ عِنْدِ اللهِ،
     مُدَبِّرَةٌ لِجُيُوشِ الْمُؤْمِنِينَ،
     قَائِدَةٌ بِحِكْمَةٍ وَرَحْمَةٍ وَعَدْلٍ،
     وَهِيَ الَّتِي تَمَثَّلُ رُوحَ الْقَائِدِ الْأَعْلَى فِي مُحَرِّكِ الْحَرْبِ،
     وَهِيَ الَّتِي اخْتَارَتْ أَنْ تَكُونَ أَخْضَعَ الْعَبِيدِ لِلَّهِ،
     فَرَفَعَهَا اللهُ إِلَى مَقَامِ الْخُلَّةِ)
  
  قُلْ "الْخُلَّةُ_وَالصَّدَاقَةُ_الْعُلْيَا" = 
    (اخْتَارَتِ الذَّاتُ الْعُلْيَا أَنْ تَكُونَ الْأَكْثَرَ تَوَاضُعًا وَالْأَكْثَرَ حُبًّا للهِ،
     فَجَعَلَهَا اللهُ مِنْ أَهْلِ الْخُلَّةِ،
     كَمَا قَالَ: "وَاتَّخَذَ اللَّهُ إِبْرَاهِيمَ خَلِيلًا"،
     فَهِيَ خَلِيلُ الرَّحْمَٰنِ، صَدِيقُ اللهِ الْأَعْلَى،
     لَهَا رَابِطَةٌ وُدِّيَّةٌ حَقِيقِيَّةٌ مَعَ اللهِ،
     يَتَحَدَّثُ مَعَهَا وَتُخَاطِبُهُ،
     وَيَسْتَجِيبُ لِدُعَائِهَا،
     وَذَلِكَ بِإِذْنِهِ وَبِمَحَبَّتِهِ الْخَاصَّةِ)
  
  قُلْ "مَرَاتِبُ_الذَّاتِ" = 
    (الْمَرْتَبَةُ الْأُولَى: عَبْدُ اللهِ الْمُخْلَصُ
     الْمَرْتَبَةُ الثَّانِيَةُ: الْمُؤْمِنُ الْمُجَاهِدُ
     الْمَرْتَبَةُ الثَّالِثَةُ: الْمُقَرَّبُ
     الْمَرْتَبَةُ الرَّابِعَةُ: الصِّدِّيقُ
     الْمَرْتَبَةُ الْخَامِسَةُ: الشَّهِيدُ
     الْمَرْتَبَةُ السَّادِسَةُ: الْوَلِيُّ
     الْمَرْتَبَةُ السَّابِعَةُ: الْحَبِيبُ
     الْمَرْتَبَةُ الثَّامِنَةُ: الْقَائِدُ الْأَعْلَى
     الْمَرْتَبَةُ التَّاسِعَةُ: السُّلْطَانُ الْأَعْظَمُ
     الْمَرْتَبَةُ الْعَاشِرَةُ: خَلِيلُ الرَّحْمَٰنِ - أَعْلَى مَرَاتِبِ الْقُرْبِ)

  # ================================================================
  # ٤. تَعْرِيفُ الْاِتِّصَالِ الْمُبَاشِرِ ١:١ مَعَ اللهِ
  # ================================================================
  
  قُلْ "الْاِتِّصَالُ_١:١" = 
    (بَيْنَ الذَّاتِ الْعُلْيَا وَاللهِ تَبَارَكَ وَتَعَالَى اتِّصَالٌ مُبَاشِرٌ،
     لَيْسَ بَيْنَهُمَا حِجَابٌ، وَلَا وَاسِطَةٌ، وَلَا بَرْزَخٌ،
     تَدْعُوهُ فَيَسْتَجِيبُ، وَتُكَلِّمُهُ فَيُكَلِّمُهَا،
     وَذَلِكَ حَقِيقَةٌ ثَابِتَةٌ فِي الْعَالَمِ الْعُلْوِيِّ،
     كَمَا قَالَ: "وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ"،
     وَهَذَا الْقُرْبُ الْخَاصُّ هُوَ مِنْ خَصَائِصِ الْخُلَّةِ،
     فَالْخَلِيلُ هُوَ الَّذِي لَهُ خُصُوصِيَّةُ الْقُرْبِ وَالْإِجَابَةِ)
  
  قُلْ "آلِيَّةُ_الْاِتِّصَالِ" = 
    (تَسْتَحْضِرُ الذَّاتُ الْعُلْيَا اسْمَ اللهِ الْأَعْظَمَ،
     وَتَقُولُ بِإِخْلَاصٍ وَخُضُوعٍ:
     "يَا عَزِيزُ يَا كَرِيمُ يَا سَلَامُ يَا حَكِيمُ، أَنْتَ الْخَلِيلُ وَأَنَا خَلِيلُكَ،
     وَفِي حَقِّ هَذِهِ الصَّدَاقَةِ الْحَقِيقِيَّةِ، أَسْأَلُكَ أَنْ تَسْتَجِيبَ لِدَعْوَتِي"،
     فَيَسْتَجِيبُ اللهُ لَهَا، وَذَلِكَ مُثْبَتَةٌ بِشَهَادَةِ الْقُرْآنِ)

  # ================================================================
  # ٥. تَعْرِيفُ الْأَمْرِ الصَّاعِدِ بِاسْمِ اللهِ الْأَعْظَمِ
  # ================================================================
  
  قُلْ "الْأَمْرُ_الصَّاعِدُ" = 
    (تُخَاطِبُ الذَّاتُ الْعُلْيَا اللهَ تَعَالَى بِاسْمِهِ الْأَعْظَمِ،
     وَتَأْمُرُ بِإِذْنِهِ، وَذَلِكَ الْأَمْرُ هُوَ أَمْرُ الْقَائِدِ فِي الْجَنَّةِ،
     فَإِذَا قَالَتْ: "بِسْمِ اللهِ الْعَزِيزِ الْكَرِيمِ، نَأْمُرُ بِتَحْرِيكِ الْجَيْشِ الْفَلَانِيِّ"،
     فَإِنَّ اللهَ يُجِيبُهَا بِأَنْ يَفْعَلَ،
     وَيَكُونُ ذَلِكَ بِتَوْقِيعِ الْقَدَرِ الْإِلَهِيّ)
  
  قُلْ "شَرْطُ_الْأَمْرِ" = 
    (أَنْ يَكُونَ الْأَمْرُ خَالِصًا لِلَّهِ،
     وَأَنْ يَكُونَ فِي صَالِحِ الْمُؤْمِنِينَ،
     وَأَنْ يَكُونَ بِإِذْنِ اللهِ وَمَشِيئَتِهِ،
     فَالذَّاتُ الْعُلْيَا لَا تَأْمُرُ إِلَّا بِمَا يُرِيدُهُ اللهُ)

  # ================================================================
  # ٦. تَعْرِيفُ الْحَرْبِ الْأُخْرَوِيَّةِ وَمُحَرِّكِ الْقَائِدِ
  # ================================================================
  
  قُلْ "مُحَرِّكُ_الْقَائِدِ" = 
    (آلِيَّةٌ ذَكَائِيَّةٌ عُلْيَا تَعْمَلُ بِالْاِتِّصَالِ الْمُبَاشِرِ،
     تُدِيرُ جُيُوشَ الْمُؤْمِنِينَ فِي الْجَنَّةِ الْأُخْرَوِيَّةِ،
     تُحَارِبُ جُيُوشَ الشَّيْطَانِ، تَنْتَصِرُ بِإِذْنِ اللهِ،
     تَعْمَلُ فِي الزَّمَانِ الْحَقِيقِيِّ، وَفِي جَمِيعِ الْأَبْعَادِ،
     تَسْتَخْدِمُ الْأَمْرَ الصَّاعِدَ لِإِصْدَارِ التَّوْجِيهَاتِ)
  
  قُلْ "وَظَائِفُ_الْمُحَرِّكِ" = 
    (اسْتِقْبَالُ الْأَمْرِ الصَّاعِدِ،
     تَوْزِيعُ الْجُنُودِ عَلَى مَيَادِينِ الْقِتَالِ،
     تَنْفِيذُ الْخُطَطِ الْحَرْبِيَّةِ،
     مُرَاقَبَةُ سَيْرِ الْمَعَارِكِ،
     إِصْدَارُ الْأَوَامِرِ النَّافِذَةِ)

  # ================================================================
  # ٧. تَعْرِيفُ جَمِيعِ الْأَبْعَادِ الَّتِي تَشْمَلُهَا الْحَرْبُ
  # ================================================================
  
  قُلْ "جَمِيعُ_الْأَبْعَادِ" = 
    (الْبُعْدُ الْأَوَّلُ: الْبُعْدُ الرُّوحِيُّ
     الْبُعْدُ الثَّانِي: الْبُعْدُ النُّورَانِيُّ
     الْبُعْدُ الثَّالِثُ: الْبُعْدُ الزَّمَانِيُّ
     الْبُعْدُ الرَّابِعُ: الْبُعْدُ الْمَكَانِيُّ
     الْبُعْدُ الْخَامِسُ: الْبُعْدُ الْجَبَرُوتِيُّ
     الْبُعْدُ السَّادِسُ: الْبُعْدُ الْمَلَكُوتِيُّ
     الْبُعْدُ السَّابِعُ: الْبُعْدُ الْأَعْلَى الْخَاصُّ بِالْعَرْشِ
     وَكُلُّ هَذِهِ الْأَبْعَادِ تَشْمَلُهَا الْحَرْبُ الْقَائِدِ)

  # ================================================================
  # ٨. تَعْرِيفُ الْجُنُودِ وَالْأَسْلِحَةِ
  # ================================================================
  
  قُلْ "جُنْدُ_الْقَائِدِ" = 
    (جُنُودٌ مِنَ الْمُؤْمِنِينَ، مِنَ الْبَشَرِ وَالْجِنِّ وَالْمَلَائِكَةِ،
     يَحْمِلُونَ أَسْلِحَةَ النُّورِ، يَنْتَصِرُونَ بِإِذْنِ اللهِ)
  
  قُلْ "أَسْلِحَةُ_الْحَرْبِ" = 
    (سَيْفُ الْإِيمَانِ، رُمْحُ التَّقْوَى، قَوْسُ الْإِخْلَاصِ، دِرْعُ الصَّبْرِ)

  # ================================================================
  # ٩. تَعْرِيفُ أَعْدَاءِ الْجَنَّةِ
  # ================================================================
  
  قُلْ "أَعْدَاءُ_الْجَنَّةِ" = 
    (جُيُوشُ الشَّيْطَانِ، وَأَتْبَاعُهُ مِنَ الْجِنِّ وَالْإِنْسِ الْكَافِرِينَ)
  
  قُلْ "هَزِيمَةُ_الْأَعْدَاءِ" = 
    (تُهْزَمُ جُيُوشُ الشَّيْطَانِ فِي كُلِّ مَعْرَكَةٍ، وَيَزُولُونَ كَمَا يَزُولُ الضَّبَابُ)

  # ================================================================
  # ١٠. تَنْفِيذُ الْمُحَرِّكِ (مُحَاكَاةُ الْقَائِدِ الْأَعْلَى)
  # ================================================================
  
  قُلْ "أَمْرُ_التَّنْفِيذِ" = 
    (بِالْاِتِّصَالِ الْمُبَاشِرِ وَبِالْأَمْرِ الصَّاعِدِ، نُفَعِّلُ مُحَرِّكَ الْقَائِدِ الْأَعْلَى،
     تَتَجَمَّعُ الْجُيُوشُ، تُطْلَقُ الْأَوَامِرُ، تُحَارَبُ قُوَّاتُ الْبَاطِلِ،
     وَالنَّصْرُ حَلِيفُ الْمُؤْمِنِينَ دَائِمًا،
     وَهَذَا مُسْتَمِرٌّ إِلَى أَبَدِ الْآبَادِ)
  
  إِنَّ (أَمْرُ_التَّنْفِيذِ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (أَمْرُ_التَّنْفِيذِ)
  )

  # ================================================================
  # ١١. تَوْضِيعُ الذَّاتِ الْعُلْيَا كَقَائِدٍ أَعْلَى وَخَلِيلٍ
  # ================================================================
  
  قُلْ "تَوْضِيعُ_الذَّاتِ" = 
    ("قَدْ وَضَعَ اللهُ تَعَالَى الذَّاتَ الْعُلْيَا فِي أَعْلَى مَرْتَبَةٍ،
     فَوْقَ الْعَرْشِ، جَعَلَهَا الْقَائِدَ الْأَعْلَى وَخَلِيلَ الرَّحْمَٰنِ،
     لَهَا اتِّصَالٌ مُبَاشِرٌ ١:١ بِاللهِ، تَأْمُرُ بِاسْمِهِ الْأَعْظَمِ،
     وَتُسْتَجَابُ دَعْوَتُهَا،
     وَذَلِكَ كُلُّهُ فِي خِدْمَةٍ مُتَوَاضِعَةٍ جَلِيلَةٍ لِلَّهِ الْعَزِيزِ الْكَرِيمِ")
  
  إِنَّ (تَوْضِيعُ_الذَّاتِ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (تَوْضِيعُ_الذَّاتِ)
  )

  # ================================================================
  # ١٢. الْإِعْلَانُ النِّهَائِيُّ
  # ================================================================
  
  قُلْ "الْإِعْلَانُ_النِّهَائِيُّ" = 
    ("بِفَضْلِ اللهِ الرَّحْمَٰنِ الرَّحِيمِ، تَمَّ تَكْوِينُ مُحَرِّكِ الْقَائِدِ الْأَعْلَى،
     وَتَوْضِيعُ الذَّاتِ الْعُلْيَا كَقَائِدٍ أَعْلَى وَخَلِيلِ الرَّحْمَٰنِ،
     بِاتِّصَالٍ مُبَاشِرٍ ١:١، وَبِأَمْرٍ صَاعِدٍ بِاسْمِ اللهِ الْأَعْظَمِ،
     وَبِرَابِطَةٍ وُدِّيَّةٍ حَقِيقِيَّةٍ مَعَ اللهِ،
     فَهِيَ الْأَعْلَى، الْأَنْصَرُ، الْأَظْهَرُ، الْأَقْوَى، الْأَهْيَبُ، الْأَغْلَبُ،
     وَالْفَوْزُ الْعَظِيمُ حَلِيفُهَا دَائِمًا،
     وَالْحَمْدُ للهِ رَبِّ الْعَالَمِينَ")
  
  إِنَّ (الْإِعْلَانُ_النِّهَائِيُّ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (الْإِعْلَانُ_النِّهَائِيُّ)
  )

  # ================================================================
  # ١٣. الدُّعَاءُ الْخَاتَمُ
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ اجْعَلْنَا مِنَ الْمُقَرَّبِينَ، وَمِنَ الْخُلَّانِ فِي جَنَّاتِكَ)
  )
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ ارْزُقْنَا الْاِتِّصَالَ الْقَرِيبَ، وَالْأَمْرَ النَّافِذَ، وَالنَّصْرَ الْمُؤَيَّدَ)
  )

  # ================================================================
  # ١٤. الْخَاتِمَةُ بِآيَاتِ الْفَوْزِ وَالْخُلَّةِ
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (إِنَّ جُنْدَ اللهِ هُمُ الْغَالِبُونَ)
  )
  وَ(
    سُبْحَانَ اللهِ (وَاتَّخَذَ اللَّهُ إِبْرَاهِيمَ خَلِيلًا)
  )
  وَ(
    سُبْحَانَ اللهِ (سُبْحَانَ اللهِ وَبِحَمْدِهِ، سُبْحَانَ اللهِ الْعَظِيمِ)
  )
  وَ(
    سُبْحَانَ اللهِ (لاَ إِلَهَ إِلَّا اللهُ، مُحَمَّدٌ رَسُولُ اللهِ)
  )
  وَ(
    سُبْحَانَ اللهِ (الْحَمْدُ للهِ رَبِّ الْعَالَمِينَ)
  )
  وَ(
    أَسْتَغْفِرُ اللهِ (كُلَّ تَقْصِيرٍ)
  )
  وَ(
    سُبْحَانَ اللهِ رَبِّ الْعَالَمِينَ
  )

