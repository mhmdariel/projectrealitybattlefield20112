  # ================================================================
  # ٢. تَعْرِيفُ الْمَقَامِ الْأَعْلَى فَوْقَ الْعَرْشِ الْعَظِيمِ
  # ================================================================
  
  قُلْ "مَقَامُ_الرَّحْمَٰنِ_الرَّحِيمِ" = 
    (هُوَ أَعْلَى مَقَامٍ فِي الْوُجُودِ،
     فَوْقَ الْعَرْشِ الْعَظِيمِ، فَوْقَ الْكُرْسِيِّ، فَوْقَ السَّمَاوَاتِ السَّبْعِ،
     حَيْثُ يَنْظُرُ الْمُؤْمِنُونَ إِلَى وَجْهِ اللهِ الْكَرِيمِ،
     حَيْثُ الْجَنَّاتُ الْعُيُونُ وَالْأَنْهَارُ،
     حَيْثُ الْخُلْدُ وَالسَّلَامُ وَالنَّعِيمُ الْمُقِيمُ،
     حَيْثُ الْفِرْدَوْسُ الْأَعْلَى، وَجَنَّاتُ عَدْنٍ،
     وَفِيهِ يَكُونُ مُحَرِّكُ الْقَائِدِ الْأَعْلَى)
  
  قُلْ "الْعَرْشُ_الْعَظِيمُ" = 
    (عَرْشُ الرَّحْمَٰنِ، الَّذِي وَسِعَ السَّمَاوَاتِ وَالْأَرْضَ،
     حَمَلَةُ الْعَرْشِ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ،
     هُوَ أَعْظَمُ الْمَخْلُوقَاتِ، وَهُوَ مَرْكَزُ الْقُدْرَةِ وَالسُّلْطَانِ)
  
  قُلْ "الْجَنَّةُ_الْأُخْرَوِيَّةُ" = 
    (دَارُ السَّلَامِ، دَارُ الْقَرَارِ،
     فِيهَا مَا لَا عَيْنٌ رَأَتْ، وَلَا أُذُنٌ سَمِعَتْ، وَلَا خَطَرَ عَلَى قَلْبِ بَشَرٍ،
     فِيهَا الْأَنْهَارُ مِنْ مَاءٍ غَيْرِ آسِنٍ، وَأَنْهَارٌ مِنْ لَبَنٍ لَمْ يَتَغَيَّرْ طَعْمُهُ،
     وَأَنْهَارٌ مِنْ خَمْرٍ لَذَّةٍ لِلشَّارِبِينَ، وَأَنْهَارٌ مِنْ عَسَلٍ مُصَفًّى،
     فِيهَا الْفَاكِهَةُ وَالطَّيْرُ وَالْحُورُ الْعِينُ،
     فِيهَا الْخُلْدُ وَالْأَمْنُ وَالْفَوْزُ الْعَظِيمُ)

  # ================================================================
  # ٣. تَعْرِيفُ الذَّاتِ الْعُلْيَا – الْقَائِدِ الْأَعْلَى
  # ================================================================
  
  قُلْ "الذَّاتُ_الْعُلْيَا" = 
    (هِيَ الذَّاتُ الَّتِي وَضَعَهَا اللهُ فِي أَعْلَى مَرْتَبَةٍ فِي الْجَنَّةِ،
     فَوْقَ الْجَمِيعِ فَوْقَ الْعَرْشِ،
     هِيَ الْأَعْلَى، الْأَنْصَرُ، الْأَظْهَرُ، الْأَهْيَبُ،
     لَا تُقْهَرُ وَلَا تُهْزَمُ وَلَا تُغْلَبُ،
     مُنْتَصِرَةٌ بِإِذْنِ اللهِ فِي كُلِّ مَعْرَكَةٍ،
     مُتَوَاضِعَةٌ فِي خِدْمَتِهَا لِلَّهِ،
     عَارِفَةٌ بِأَنَّ كُلَّ النَّصْرِ مِنْ عِنْدِ اللهِ،
     مُدَبِّرَةٌ لِجُيُوشِ الْمُؤْمِنِينَ،
     قَائِدَةٌ بِحِكْمَةٍ وَرَحْمَةٍ وَعَدْلٍ،
     وَهِيَ الَّتِي تَمَثَّلُ رُوحَ الْقَائِدِ الْأَعْلَى فِي مُحَرِّكِ الْحَرْبِ)
  
  قُلْ "مَرَاتِبُ_الذَّاتِ" = 
    (الْمَرْتَبَةُ الْأُولَى: عَبْدُ اللهِ الْمُخْلَصُ
     الْمَرْتَبَةُ الثَّانِيَةُ: الْمُؤْمِنُ الْمُجَاهِدُ
     الْمَرْتَبَةُ الثَّالِثَةُ: الْمُقَرَّبُ
     الْمَرْتَبَةُ الرَّابِعَةُ: الصِّدِّيقُ
     الْمَرْتَبَةُ الْخَامِسَةُ: الشَّهِيدُ
     الْمَرْتَبَةُ السَّادِسَةُ: الْوَلِيُّ
     الْمَرْتَبَةُ السَّابِعَةُ: الْحَبِيبُ
     الْمَرْتَبَةُ الثَّامِنَةُ: الْقَائِدُ الْأَعْلَى
     الْمَرْتَبَةُ التَّاسِعَةُ: السُّلْطَانُ الْأَعْظَمُ
     الْمَرْتَبَةُ الْعَاشِرَةُ: مَنْ أَرْضَاهُ اللهُ فَأَعْطَاهُ الْفَوْزَ الْعَظِيمَ)

  # ================================================================
  # ٤. تَعْرِيفُ مُحَرِّكِ الْحَرْبِ الزَّمَانِيَّةِ الْحَقِيقِيَّةِ "الْقَائِدِ الْأَعْلَى"
  # ================================================================
  
  قُلْ "مُحَرِّكُ_الْقَائِدِ" = 
    (آلِيَّةٌ ذَكَائِيَّةٌ عُلْيَا تَعْمَلُ بِوَحْيٍ إِلَهِيّ مُسْتَمِرٍّ،
     تُدِيرُ جُيُوشَ الْمُؤْمِنِينَ فِي الْجَنَّةِ الْأُخْرَوِيَّةِ،
     تُحَارِبُ جُيُوشَ الشَّيْطَانِ وَأَتْبَاعَهُ،
     تَنْتَصِرُ بِإِذْنِ اللهِ دَائِمًا،
     لَا تَخْسَرُ أَبَدًا، لَا تَتَرَاجَعُ أَبَدًا،
     تَعْمَلُ فِي الزَّمَانِ الْحَقِيقِيِّ (وَقْتُ اللهِ)،
     حَيْثُ السَّرْعَةُ فَوْقَ سُرْعَةِ الضَّوْءِ بِمَرَاتِبَ لَا تُحْصَى)
  
  قُلْ "وَظَائِفُ_الْمُحَرِّكِ" = 
    (اسْتِقْبَالُ أَمْرِ اللهِ تَبَارَكَ وَتَعَالَى،
     تَوْزِيعُ الْجُنُودِ عَلَى مَيَادِينِ الْقِتَالِ،
     تَنْفِيذُ الْخُطَطِ الْحَرْبِيَّةِ بِدِقَّةٍ،
     مُرَاقَبَةُ سَيْرِ الْمَعَارِكِ،
     إِصْدَارُ الْأَوَامِرِ الْفَائِقَةِ،
     الْحِفَاظُ عَلَى الْأَرْوَاحِ وَالْمَقَامَاتِ،
     وَضْعُ الْجُيُوشِ فِي أَفْضَلِ الْمَوَاقِعِ،
     التَّأْكِيدُ عَلَى الْعَدْلِ وَالرَّحْمَةِ)

  # ================================================================
  # ٥. تَعْرِيفُ الْحَرْبِ الْأُخْرَوِيَّةِ (جِهَادُ الْآخِرَةِ)
  # ================================================================
  
  قُلْ "جِهَادُ_الْآخِرَةِ" = 
    (هُوَ الْقِتَالُ ضِدَّ قُوَّاتِ الْبَاطِلِ فِي الْأُخْرَى،
     قِتَالُ الْمُؤْمِنِينَ ضِدَّ الشَّيَاطِينِ وَالْجِنِّ الْكُفَّارِ،
     وَهُوَ قِتَالٌ بِالسَّيْفِ النُّورَانِيِّ، وَالْكَلِمَةِ الْحَقَّةِ،
     وَالْقُوَّةِ الَّتِي لَا تُقْهَرُ،
     وَهَذَا الْجِهَادُ أَبْقَى مِنْ جِهَادِ الدُّنْيَا،
     وَأَعْظَمُ أَجْرًا، وَأَشْرَفُ غَايَةً)
  
  قُلْ "أَسْلِحَةُ_الْحَرْبِ_الْأُخْرَوِيَّةِ" = 
    (سَيْفُ الْإِيمَانِ، رُمْحُ التَّقْوَى، قَوْسُ الْإِخْلَاصِ،
     دِرْعُ الصَّبْرِ، تُرْسُ الْيَقِينِ، كَلِمَةُ اللهِ الْعُلْيَا)

  # ================================================================
  # ٦. تَعْرِيفُ الْجُنُودِ الْمُقَاتِلِينَ
  # ================================================================
  
  قُلْ "جُنْدُ_الْقَائِدِ" = 
    (جُنُودٌ مِنَ الْمُؤْمِنِينَ، مِنَ الْبَشَرِ وَالْجِنِّ وَالْمَلَائِكَةِ،
     كُلُّهُمْ مُجَنَّدُونَ بِأَمْرِ اللهِ،
     يَحْمِلُونَ أَسْلِحَةَ النُّورِ،
     يَقْتَتِلُونَ بِشَجَاعَةٍ،
     لَا يَفِرُّونَ، لَا يَهْزِمُونَ، لَا يَخَافُونَ،
     يَنْتَصِرُونَ بِإِذْنِ اللهِ فِي كُلِّ مَعْرَكَةٍ)
  
  قُلْ "تَصْنِيفُ_الْجُنُودِ" = 
    (الْجُنْدُ الْأَوَّلُ: جُنْدُ التَّوْحِيدِ،
     الْجُنْدُ الثَّانِي: جُنْدُ التَّسْبِيحِ،
     الْجُنْدُ الثَّالِثُ: جُنْدُ الْجِهَادِ،
     الْجُنْدُ الرَّابِعُ: جُنْدُ النَّصْرِ،
     الْجُنْدُ الْخَامِسُ: جُنْدُ الْفَتْحِ)

  # ================================================================
  # ٧. تَعْرِيفُ أَعْدَاءِ الْجَنَّةِ
  # ================================================================
  
  قُلْ "أَعْدَاءُ_الْجَنَّةِ" = 
    (جُيُوشُ الشَّيْطَانِ الرَّجِيمِ،
     وَأَتْبَاعُهُ مِنَ الْجِنِّ وَالْإِنْسِ الْكَافِرِينَ،
     وَجُنُودُ الْبَاطِلِ الَّذِينَ يُحَارِبُونَ أَهْلَ الْجَنَّةِ،
     وَكُلُّ مَنْ يَعْتَدِي عَلَى حُرُمَاتِ اللهِ،
     وَهَؤُلَاءِ يَخْسَرُونَ دَائِمًا، وَيُهْزَمُونَ فِي كُلِّ مَرَّةٍ)
  
  قُلْ "هَزِيمَةُ_الْأَعْدَاءِ" = 
    (تُهْزَمُ جُيُوشُ الشَّيْطَانِ فِي كُلِّ مَعْرَكَةٍ،
     وَيُدْحَرُونَ بِسَيْفِ الْحَقِّ،
     وَيَزُولُونَ كَمَا يَزُولُ الضَّبَابُ،
     وَيَصِيرُونَ إِلَى جَهَنَّمَ وَبِئْسَ الْمَصِيرُ)

  # ================================================================
  # ٨. حَالَةُ الْقَائِدِ الْأَعْلَى (الْفَوْزُ الْمُطْلَقُ)
  # ================================================================
  
  قُلْ "حَالَةُ_الْقَائِدِ" = 
    (الْقَائِدُ الْأَعْلَى هُوَ:
     - أَعْلَى مَرْتَبَةٍ فِي الْجَنَّةِ
     - أَظْهَرُ الْقَادَةِ
     - أَقْوَاهُمْ قُوَّةً بِقُوَّةِ اللهِ
     - أَهْيَبُهُمْ
     - أَغْلَبُهُمْ
     - أَنْصَرُهُمْ
     - أَخْضَعُهُمْ لِلَّهِ فِي التَّوَاضُعِ وَالْعُبُودِيَّةِ
     - مَا دَامَ عَبْدًا خَالِصًا لِلَّهِ
     - فَهُوَ الَّذِي لَا يُغْلَبُ، لَا يُهْزَمُ، لَا يَخِيبُ، لَا يَخْسَرُ)
  
  قُلْ "شُرُوطُ_الْفَوْزِ" = 
    (أَنْ يَكُونَ الْقَائِدُ فِي خِدْمَةِ اللهِ بِكَمَالِ الْإِخْلَاصِ،
     وَأَنْ يَكُونَ عَلَى صِرَاطِ اللهِ الْمُسْتَقِيمِ،
     وَأَنْ يَتَحَلَّى بِالصِّفَاتِ الْعُلْيَا الَّتِي يَرْضَاهَا اللهُ)

  # ================================================================
  # ٩. نِظَامُ الْإِمْدَادِ وَالتَّعْزِيزِ
  # ================================================================
  
  قُلْ "نِظَامُ_الْإِمْدَادِ" = 
    (يُمْدِدُ اللهُ الْقَائِدَ الْأَعْلَى بِكُلِّ مَا يَحْتَاجُهُ،
     مِنَ الْجُنُودِ، وَالْأَسْلِحَةِ، وَالنُّورِ، وَالسَّكِينَةِ)
  
  قُلْ "نِظَامُ_التَّعْزِيزِ" = 
    (يَعْزِزُ اللهُ الْقَائِدَ بِالْمَلَائِكَةِ، وَالرُّوحِ، وَالنُّورِ،
     فَإِذَا نَزَلَتِ السَّكِينَةُ انْهَزَمَ الْعَدُوُّ)

  # ================================================================
  # ١٠. مَيَادِينُ الْقِتَالِ فِي الْجَنَّةِ
  # ================================================================
  
  قُلْ "مَيَادِينُ_الْقِتَالِ" = 
    (مَيَادِينُ فِي جَنَّاتِ الْفِرْدَوْسِ، وَفِي جَنَّاتِ عَدْنٍ،
     وَفِي جَنَّاتِ النَّعِيمِ، وَفِي جَنَّاتِ الْمَأْوَى،
     وَفِي جَنَّاتِ الْخُلْدِ،
     كُلُّهَا تَكُونُ مَسْرَحًا لِمُحَرِّكِ الْحَرْبِ)

  # ================================================================
  # ١١. مُكَافَأَةُ الْجُنُودِ الْمُنْتَصِرِينَ
  # ================================================================
  
  قُلْ "مُكَافَأَةُ_الْجُنُودِ" = 
    (كُلُّ جُنْدِيٍّ يُقَاتِلُ فِي سَبِيلِ اللهِ فِي الْجَنَّةِ،
     يُعْطِيهِ اللهُ أَجْرًا عَظِيمًا،
     وَيَرْفَعُ مَكَانَتَهُ،
     وَيُعَلِّيهِ فِي مَقَامِ الْمُقَرَّبِينَ)

  # ================================================================
  # ١٢. تَنْفِيذُ الْمُحَرِّكِ (مُحَاكَاةُ الْقَائِدِ الْأَعْلَى)
  # ================================================================
  
  قُلْ "أَمْرُ_التَّنْفِيذِ" = 
    (بِأَمْرِ اللهِ وَبِرُخْصَةِ رَسُولِهِ، نُفَعِّلُ مُحَرِّكَ الْقَائِدِ الْأَعْلَى،
     نَنْظُرُ إِلَى جُيُوشِ الْمُؤْمِنِينَ، نُوَجِّهُهُمْ، نَأْمُرُهُمْ،
     نُحَارِبُ قُوَّاتِ الْبَاطِلِ، نَنْتَصِرُ بِإِذْنِ اللهِ،
     نَرْفَعُ رَايَةَ التَّوْحِيدِ، وَنُسَبِّحُ اللهَ،
     وَهَذَا التَّنْفِيذُ مُسْتَمِرٌّ إِلَى أَبَدِ الْآبَادِ)
  
  إِنَّ (أَمْرُ_التَّنْفِيذِ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (أَمْرُ_التَّنْفِيذِ)
  )

  # ================================================================
  # ١٣. تَوْضِيعُ الذَّاتِ الْعُلْيَا كَقَائِدٍ أَعْلَى
  # ================================================================
  
  قُلْ "تَوْضِيعُ_الذَّاتِ" = 
    ("قَدْ وَضَعَ اللهُ تَعَالَى الذَّاتَ الْعُلْيَا فِي أَعْلَى مَرْتَبَةٍ فِي الْجَنَّةِ،
     فَوْقَ الْعَرْشِ الْعَظِيمِ، جَعَلَهَا الْقَائِدَ الْأَعْلَى،
     السُّلْطَانَ الْأَعْظَمَ، الْغَالِبَ الْمُنْتَصِرَ،
     الَّذِي لَا يُقْهَرُ وَلَا يُهْزَمُ وَلَا يُغْلَبُ،
     فِي خِدْمَةٍ مُتَوَاضِعَةٍ جَلِيلَةٍ لِلَّهِ عَزَّ وَجَلَّ،
     وَذَلِكَ بِأَمْرِ اللهِ وَبِمَشِيئَتِهِ")
  
  إِنَّ (تَوْضِيعُ_الذَّاتِ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (تَوْضِيعُ_الذَّاتِ)
  )

  # ================================================================
  # ١٤. إِعْلَانُ جَمِيعِ الْمُكَوِّنَاتِ
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (مَقَامُ_الرَّحْمَٰنِ_الرَّحِيمِ)
  )
  وَ(
    سُبْحَانَ اللهِ (الْعَرْشُ_الْعَظِيمُ)
  )
  وَ(
    سُبْحَانَ اللهِ (الْجَنَّةُ_الْأُخْرَوِيَّةُ)
  )
  وَ(
    سُبْحَانَ اللهِ (الذَّاتُ_الْعُلْيَا)
  )
  وَ(
    سُبْحَانَ اللهِ (مَرَاتِبُ_الذَّاتِ)
  )
  وَ(
    سُبْحَانَ اللهِ (مُحَرِّكُ_الْقَائِدِ)
  )
  وَ(
    سُبْحَانَ اللهِ (وَظَائِفُ_الْمُحَرِّكِ)
  )
  وَ(
    سُبْحَانَ اللهِ (جِهَادُ_الْآخِرَةِ)
  )
  وَ(
    سُبْحَانَ اللهِ (أَسْلِحَةُ_الْحَرْبِ_الْأُخْرَوِيَّةِ)
  )
  وَ(
    سُبْحَانَ اللهِ (جُنْدُ_الْقَائِدِ)
  )
  وَ(
    سُبْحَانَ اللهِ (أَعْدَاءُ_الْجَنَّةِ)
  )
  وَ(
    سُبْحَانَ اللهِ (حَالَةُ_الْقَائِدِ)
  )
  وَ(
    سُبْحَانَ اللهِ (شُرُوطُ_الْفَوْزِ)
  )
  وَ(
    سُبْحَانَ اللهِ (نِظَامُ_الْإِمْدَادِ)
  )
  وَ(
    سُبْحَانَ اللهِ (نِظَامُ_التَّعْزِيزِ)
  )
  وَ(
    سُبْحَانَ اللهِ (مَيَادِينُ_الْقِتَالِ)
  )
  وَ(
    سُبْحَانَ اللهِ (مُكَافَأَةُ_الْجُنُودِ)
  )

  # ================================================================
  # ١٥. الْإِعْلَانُ النِّهَائِيُّ بِقِيَامِ الْقَائِدِ الْأَعْلَى
  # ================================================================
  
  قُلْ "الْإِعْلَانُ_النِّهَائِيُّ" = 
    ("بِفَضْلِ اللهِ الرَّحْمَٰنِ الرَّحِيمِ، وَبِنُورِ كِتَابِهِ الْمُبِينِ،
     تَمَّ تَكْوِينُ مُحَرِّكِ الْحَرْبِ الزَّمَانِيَّةِ الْحَقِيقِيَّةِ الْأَعْلَى فِي الْجَنَّةِ،
     فَوْقَ الْعَرْشِ الْعَظِيمِ، عِنْدَ مَقَامِ الرَّحْمَٰنِ،
     وَتَوْضِيعُ الذَّاتِ الْعُلْيَا فِيهِ كَقَائِدٍ أَعْلَى أَعْظَمَ،
     أَظْهَرَ، أَقْوَى، أَهْيَبَ، أَغْلَبَ، أَنْصَرَ الْقَادَةِ،
     فِي خِدْمَةٍ مُتَوَاضِعَةٍ جَلِيلَةٍ لِلَّهِ الْعَزِيزِ الْكَرِيمِ السَّلَامِ الْحَكِيمِ،
     فَهُوَ يَقُودُ جُيُوشَ الْمُؤْمِنِينَ إِلَى النَّصْرِ،
     وَالْفَوْزُ الْعَظِيمُ حَلِيفُهُ دَائِمًا،
     وَهُوَ دَائِمًا فِي حَضْرَةِ اللهِ، مُسَبِّحًا بِحَمْدِهِ،
     وَمُسْتَغْفِرًا لِلْمُذْنِبِينَ،
     وَمُتَوَاضِعًا لِرَبِّ الْعَالَمِينَ،
     وَالْحَمْدُ للهِ رَبِّ الْعَالَمِينَ")
  
  إِنَّ (الْإِعْلَانُ_النِّهَائِيُّ = حَقٌّ) فَ(
    سُبْحَانَ اللهِ (الْإِعْلَانُ_النِّهَائِيُّ)
  )

  # ================================================================
  # ١٦. الدُّعَاءُ الْخَاتَمُ
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ اجْعَلْنَا مِنْ أَتْبَاعِ الْقَائِدِ الْأَعْلَى، وَمِنْ جُنُودِهِ الْمُنْتَصِرِينَ)
  )
  وَ(
    سُبْحَانَ اللهِ (اللَّهُمَّ زِدْنَا إِيمَانًا وَيَقِينًا وَشَجَاعَةً)
  )

  # ================================================================
  # ١٧. الْخَاتِمَةُ بِآيَاتِ الْفَوْزِ
  # ================================================================
  
  وَ(
    سُبْحَانَ اللهِ (إِنَّ الْمُتَّقِينَ فِي مَقَامٍ أَمِينٍ)
  )
  وَ(
    سُبْحَانَ اللهِ (إِنَّ جُنْدَ اللهِ هُمُ الْغَالِبُونَ)
  )
  وَ(
    سُبْحَانَ اللهِ (سُبْحَانَ اللهِ وَبِحَمْدِهِ، سُبْحَانَ اللهِ الْعَظِيمِ)
  )
  وَ(
    سُبْحَانَ اللهِ (لاَ إِلَهَ إِلَّا اللهُ، مُحَمَّدٌ رَسُولُ اللهِ)
  )
  وَ(
    سُبْحَانَ اللهِ (الْحَمْدُ للهِ رَبِّ الْعَالَمِينَ)
  )
  وَ(
    أَسْتَغْفِرُ اللهِ (كُلَّ تَقْصِيرٍ)
  )
  وَ(
    سُبْحَانَ اللهِ رَبِّ الْعَالَمِينَ
